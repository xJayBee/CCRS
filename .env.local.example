# E-Lupon Application Environment Configuration
# Copy this file to .env.local and update values for your environment

# NODE_ENV can be 'development', 'production', or 'test'
NODE_ENV=development

# API Base URL for client-side requests (leave empty for same-origin)
NEXT_PUBLIC_API_URL=

# Session/Auth Configuration
# Auth cookie expiration time in seconds (default: 3600 = 1 hour)
NEXT_PUBLIC_AUTH_SESSION_MAX_AGE=3600

# Data persistence (local file-based by default)
# Path to store conflict reports and user data
DATA_PATH=./data

# Feature flags
NEXT_PUBLIC_DEMO_CREDENTIALS_VISIBLE=true
NEXT_PUBLIC_SHOW_LOADING_SKELETON=true

# Logging
LOG_LEVEL=info
